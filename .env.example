# AI Radar V1.0 - local development template.
#
# Copy to `.env` for local runs. In production these values live in GitHub
# encrypted secrets and are injected as environment variables; never commit a
# real `.env`, and never paste a real secret into chat, an issue or a source file.
#
# Every value below is a placeholder. A placeholder is not a credential: the
# system reports the integration as NOT CONFIGURED until a real value is supplied.

# --- Storage (primary source of truth) --------------------------------------
# Supabase Dashboard -> Connect -> Connection string (URI).
# Use the SHARED POOLER in SESSION mode: port 5432, username
# postgres.<project-ref>. Do NOT use the transaction pooler on 6543: Supabase
# does not support prepared statements or session advisory locks there, and this
# pipeline needs both (the run lock is session-scoped). Keep sslmode=require.
DATABASE_URL=postgresql://postgres.project-ref:YOUR-DB-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# --- Telegram ---------------------------------------------------------------
# Bot: message @BotFather, /newbot. Chat id: message the bot, then call
# https://api.telegram.org/bot<TOKEN>/getUpdates and read result[0].message.chat.id
TELEGRAM_BOT_TOKEN=<bot-token-from-botfather>
TELEGRAM_CHAT_ID=<your-numeric-chat-id>

# --- Intelligence providers (free tiers only) -------------------------------
# free.ai - OpenAI-compatible. Free plan: 30,000 tokens/day, 10 requests/min.
# Docs: https://free.ai/api/   Key looks like sk-free-...
FREEAI_API_KEY=<freeai-api-key>
# Self-hosted model; cheapest. Change only to an id returned by GET /v1/models.
FREEAI_MODEL=qwen7b
# Hard rolling-24h token budget. Keep below 30000; the adapter falls through when
# it is reached instead of overspending the pool.
FREEAI_DAILY_TOKEN_BUDGET=25000
FREEAI_MAX_CALLS_PER_RUN=2
FREEAI_MAX_OUTPUT_TOKENS=800

# https://aistudio.google.com/apikey
GEMINI_API_KEY=<gemini-api-key>
# https://console.groq.com/keys
GROQ_API_KEY=<groq-api-key>
# xAI Grok (PAID). https://console.x.ai
# Only constructed when the key is set. Leave EMPTY until credits and a budget
# are approved; an empty value disables the provider.
XAI_API_KEY=

# Sarvam AI (PAID, credits). https://dashboard.sarvam.ai
# In GitHub Actions this comes from the SARVAM_API_KEY repository secret; never
# put a real key in this file or in any tracked file.
SARVAM_API_KEY=<sarvam-api-key>
# Hard caps enforced in code, in cloud and locally:
#   SARVAM_MAX_CALLS_PER_RUN  - outbound paid requests allowed per run (default 1)
#   SARVAM_DAILY_TOKEN_BUDGET - rolling 24h token ceiling (default 5000)
# Only set these when you intentionally change the budget; the defaults are the
# approved spend. An empty value is not the same as "unset", so prefer omitting.
# SARVAM_MAX_CALLS_PER_RUN=1
# SARVAM_DAILY_TOKEN_BUDGET=5000
# SARVAM_MAX_OUTPUT_TOKENS=800
# Optional: pin a model id. Empty means "resolve from the provider's /models".
GEMINI_MODEL=
GROQ_MODEL=
XAI_MODEL=
XAI_BASE_URL=https://api.x.ai
SARVAM_MODEL=sarvam-105b
SARVAM_BASE_URL=https://api.sarvam.ai

# --- Source collection ------------------------------------------------------
# Optional. A read-only PAT raises the GitHub API limit from 60 to 5000 req/hour.
# In GitHub Actions, ${{ secrets.GITHUB_TOKEN }} already covers this.
GITHUB_TOKEN=<github-read-only-pat>

# --- Backup (Google Drive, user-owned folder) -------------------------------
# OAuth2 "installed app" client with the drive.file scope plus a refresh token, so
# the weekly job can run unattended. See docs/backup-restore.md for the one-time
# consent flow that produces the refresh token.
GOOGLE_OAUTH_CLIENT_ID=<oauth-client-id>
GOOGLE_OAUTH_CLIENT_SECRET=<oauth-client-secret>
GOOGLE_OAUTH_REFRESH_TOKEN=<oauth-refresh-token>
# Optional. Leave empty: the app creates its own "AI Radar Backups" folder, which
# the drive.file scope can read and write. A folder you created in Drive is NOT
# accessible to this scope, so a user folder id will fail with 404.
GOOGLE_DRIVE_FOLDER_ID=

# --- Restore rehearsal ------------------------------------------------------
# A second, empty database. `ai-radar restore` refuses to write into DATABASE_URL.
RESTORE_DATABASE_URL=

# --- Independent heartbeat --------------------------------------------------
# healthchecks.io ping URL, e.g. https://hc-ping.com/00000000-0000-0000-0000-000000000000
HEALTHCHECKS_PING_URL=

# --- Local backup export ----------------------------------------------------
# `ai_radar backup --local-dir backups` writes and SHA-256-verifies a gzip JSON
# export without Google OAuth. The offsite copy still requires the Drive secrets
# above. `backups/` is gitignored.

# --- Staging validation (docs/staging-validation.md) -------------------------
# Leave both EMPTY for normal operation. Set them in the shell, never here, when
# validating the full pipeline: staging mode then reads only the staging DSN and
# structurally disables Telegram, Gemini, Groq, healthchecks and Drive.
# AI_RADAR_STAGING=1
# AI_RADAR_STAGING_DATABASE_URL=postgresql://postgres.<staging-ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Optional tuning --------------------------------------------------------
# AI_RADAR_CONFIG_DIR=./config
# AI_RADAR_LOG_LEVEL=INFO
# AI_RADAR_STALE_AFTER_MINUTES=150
